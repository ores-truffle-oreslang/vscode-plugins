{
  "name": "oreslang-vscode",
  "displayName": "Oreslang",
  "description": "Syntax highlighting, exact keyword colors, and editor diagnostics for Oreslang.",
  "version": "0.1.0",
  "publisher": "ores-truffle-oreslang",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "activationEvents": [
    "onLanguage:oreslang",
    "onCommand:oreslang.checkCurrentFile"
  ],
  "main": "./extension.js",
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "contributes": {
    "languages": [
      {
        "id": "oreslang",
        "aliases": [
          "Oreslang",
          "oreslang",
          "ores"
        ],
        "extensions": [
          ".ores"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "oreslang",
        "scopeName": "source.oreslang",
        "path": "./syntaxes/oreslang.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "oreslang.checkCurrentFile",
        "title": "Oreslang: Check Current File"
      }
    ],
    "configuration": {
      "title": "Oreslang",
      "properties": {
        "oreslang.colors.keyword": {
          "type": "string",
          "default": "#FF00FF",
          "description": "Exact editor color for Oreslang language keywords."
        },
        "oreslang.colors.runtimeGlobal": {
          "type": "string",
          "default": "#4169E1",
          "description": "Exact editor color for Oreslang runtime globals such as recover, defer, throw, and raise."
        },
        "oreslang.diagnostics.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable built-in lexical and structural diagnostics."
        },
        "oreslang.cli.command": {
          "type": "string",
          "default": "oreslang",
          "description": "Oreslang developer-tooling CLI executable."
        },
        "oreslang.cli.args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "check",
            "--format=json",
            "{file}"
          ],
          "description": "Arguments for the Oreslang CLI. {file} and {workspaceFolder} are substituted."
        },
        "oreslang.cli.runOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Run `oreslang check` after saving an Oreslang file."
        },
        "oreslang.cli.timeoutMs": {
          "type": "number",
          "default": 10000,
          "minimum": 100,
          "description": "Timeout for an `oreslang check` invocation."
        }
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ores-truffle-oreslang/vscode-plugins.git"
  }
}
